# Maintainer: hypr-enhanced-session project — patched build for Hyper-V

pkgname=aquamarine-hyprv
pkgver=0.14.0
pkgrel=1
pkgdesc="A very light linux rendering backend library (patched for Hyper-V: stop the per-frame CDRMRenderer retry loop when there's no DRM render node)"
arch=('x86_64')
url="https://github.com/hyprwm/aquamarine"
license=('BSD-3-Clause')
depends=('libglvnd' 'libdrm' 'mesa' 'libinput' 'pixman' 'seatd' 'hyprutils')
makedepends=('cmake' 'ninja' 'git' 'wayland-protocols' 'hyprwayland-scanner')
provides=('aquamarine' 'libaquamarine.so=13-64')
conflicts=('aquamarine')
# The patch entry is a symlink to ../../patches/ so the file has one
# canonical copy in the repo but makepkg still finds it next to the
# PKGBUILD (a ${startdir}/../.. path would only work inside a checkout).
source=("https://github.com/hyprwm/aquamarine/archive/refs/tags/v${pkgver}.tar.gz"
        "aquamarine-part1-renderer-init-failed.patch")
sha256sums=('5dcf0b17f7dd51539fd7e79d68484f04240b3b63cf9f5f21d5b6dea0088168f9'
            'c7c9947796016938e3c52af0b5d48ee452b5484fd9b1c225d5eb3dfa359bf540')

prepare() {
    # Renderer init fallback: on hyperv_drm (no DRM render node), CDRMRenderer::attempt()
    # fails every time initMgpu() is called, which happens on every frame commit — this
    # latches the failure so it's only attempted (and logged) once. Actual rendering is
    # unaffected: Mesa's llvmpipe fallback already runs the compositor in software.
    patch -Np1 -d "aquamarine-${pkgver}" < aquamarine-part1-renderer-init-failed.patch
}

build() {
    cmake -S "aquamarine-${pkgver}" \
          -B build \
          -G Ninja \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_INSTALL_PREFIX=/usr
    ninja -C build
}

package() {
    DESTDIR="${pkgdir}" ninja -C build install
    install -Dm644 "aquamarine-${pkgver}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
